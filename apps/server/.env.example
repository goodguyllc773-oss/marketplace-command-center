# Copy to .env — never commit the real .env
DATABASE_URL="file:./dev.db"

# Local API auth — every request to the server must send this as
# `x-api-key`. Generate your own random value.
LOCAL_API_KEY="change-me-to-a-random-string"

PORT=4000
HOST=127.0.0.1

# Optional: Discord notifications (Phase 10)
DISCORD_WEBHOOK_URL=

# Optional: set to true to also offer the mock platforms (fake sample data,
# for development only). Off by default.
MCC_ENABLE_MOCKS=

# Facebook conversation hydration limits (defaults shown; conservative on purpose)
# FB_HYDRATIONS_PER_CYCLE=3
# FB_HYDRATION_PAUSE_MS=5000
# FB_HYDRATION_MAX_SCROLLS=6
# FB_HYDRATION_MANUAL_MAX_SCROLLS=25
# FB_HYDRATION_SCROLL_WAIT_MS=1500
# FB_HYDRATION_PAGE_TIMEOUT_MS=45000
