# Copy to .env — never commit the real .env
DATABASE_URL="file:./dev.db"

# Local API auth — every request to the server must send this as
# `x-api-key`. Generate your own random value.
LOCAL_API_KEY="change-me-to-a-random-string"

PORT=4000
HOST=127.0.0.1

# Optional: Discord notifications (Phase 10)
DISCORD_WEBHOOK_URL=
